# Remote smoke credentials. Copy to .env.smoke (gitignored) and fill in; never commit .env.smoke.
# Used by `npm run smoke:remote`. BASE_URL and SMOKE_EXPECT_ACCESS are passed per run, e.g.
#   BASE_URL=https://<preview-host> SMOKE_EXPECT_ACCESS=1 npm run smoke:remote
# (variables already set in the shell win over this file).

# Existing, email-confirmed account on the target environment (remote mode never signs up).
SMOKE_EMAIL=###
SMOKE_PASSWORD=###

# Cloudflare Access service token for Access-protected previews (set both or neither).
CF_ACCESS_CLIENT_ID=###
CF_ACCESS_CLIENT_SECRET=###
