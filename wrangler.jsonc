{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subtracker",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  // Required, not redundant: nodejs_compat is only default-on at compatibility_date >= 2026-08-04.
  // Removing this flag below that date silently breaks the build.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
