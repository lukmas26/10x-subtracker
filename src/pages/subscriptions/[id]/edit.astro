---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import SubscriptionForm from "@/components/subscriptions/SubscriptionForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { panelClass } from "@/lib/styles";
import {
  SUBSCRIPTION_ERRORS,
  displayableError,
  getSubscription,
  isSubscriptionId,
  listCategories,
} from "@/lib/services/subscriptions";
import type { CategoryDTO, SubscriptionEditDTO } from "@/types";

const notFound = `/subscriptions?error=${encodeURIComponent(SUBSCRIPTION_ERRORS.notFound)}`;

// A malformed, unknown or another account's id all look the same: back to the list with "not found".
const id = Astro.params.id ?? "";
if (!isSubscriptionId(id)) {
  return Astro.redirect(notFound);
}

// Only messages the app itself produces are shown; a crafted ?error= link gets a generic message.
const error = displayableError(Astro.url.searchParams.get("error"));

let categories: CategoryDTO[] = [];
let subscription: SubscriptionEditDTO | null = null;
let loadError: string | null = null;

// A null client means Supabase is not configured: Layout shows the config banner, the page shows the error.
const supabase = Astro.locals.supabase;
if (supabase) {
  try {
    [categories, subscription] = await Promise.all([listCategories(supabase), getSubscription(supabase, id)]);
  } catch {
    loadError = "Could not load the subscription. Please refresh the page.";
  }
  if (!loadError && !subscription) {
    return Astro.redirect(notFound);
  }
} else {
  loadError = SUBSCRIPTION_ERRORS.notConfigured;
}
---

<Layout title="Edit subscription">
  <div class="bg-cosmic min-h-screen w-full p-4 pb-20 sm:p-8 sm:pb-20">
    <Topbar />

    <main class="mx-auto flex w-full max-w-2xl flex-col gap-6">
      <Card className={panelClass}>
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
          <h1 class="text-heading text-2xl font-bold">Edit subscription</h1>
          <a href="/subscriptions" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
            Cancel
          </a>
        </div>
        {loadError || !subscription ? (
          <Alert variant="destructive">
            <AlertDescription>{loadError}</AlertDescription>
          </Alert>
        ) : (
          <SubscriptionForm
            categories={categories}
            serverError={error}
            initial={{
              name: subscription.name,
              amount: subscription.amount,
              currency: subscription.currency,
              cycle: subscription.cycle,
              categoryId: subscription.categoryId,
            }}
            action={`/api/subscriptions/${subscription.id}`}
            submitLabel="Save changes"
            client:load
          />
        )}
      </Card>
    </main>
  </div>
</Layout>
