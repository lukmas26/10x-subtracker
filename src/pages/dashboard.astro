---
import Layout from "@/layouts/Layout.astro";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { panelClass } from "@/lib/styles";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className={cn(panelClass, "p-8 text-center")}>
      <h1 class="text-heading mb-4 text-3xl font-bold">Dashboard</h1>
      <p class="text-muted-foreground">
        Welcome, <span class="text-card-foreground font-semibold">{user?.email}</span>
      </p>
      <p class="text-muted-foreground mt-2 text-sm">Your subscriptions live on the Subscriptions page.</p>
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
        <!-- buttonVariants, not `Button asChild`: Astro wraps React children in <astro-slot>, which Slot cannot merge into. -->
        <a href="/subscriptions" class={buttonVariants()}>Go to subscriptions</a>
        <form method="POST" action="/api/auth/signout">
          <Button type="submit" variant="outline" className="w-full">Sign out</Button>
        </form>
      </div>
    </Card>
  </div>
</Layout>
