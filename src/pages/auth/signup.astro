---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { Card } from "@/components/ui/card";
import { panelClass } from "@/lib/styles";
import { cn } from "@/lib/utils";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className={cn(panelClass, "w-full max-w-sm p-8")}>
      <h1 class="text-heading mb-6 text-center text-2xl font-bold">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Already have an account?{" "}
        <a href="/auth/signin" class="text-link rounded-sm outline-none hover:underline focus-visible:ring-3 focus-visible:ring-ring/50">
          Sign in
        </a>
      </p>
    </Card>
  </div>
</Layout>
