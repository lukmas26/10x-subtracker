---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { Card } from "@/components/ui/card";
import { panelClass } from "@/lib/styles";
import { cn } from "@/lib/utils";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className={cn(panelClass, "w-full max-w-sm p-8")}>
      <h1 class="text-heading mb-6 text-center text-2xl font-bold">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account?{" "}
        <a
          href="/auth/signup"
          class="text-link rounded-sm outline-none hover:underline focus-visible:ring-3 focus-visible:ring-ring/50"
        >
          Sign up
        </a>
      </p>
    </Card>
  </div>
</Layout>
