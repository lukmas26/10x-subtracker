---
// Dev-only visual gate: every state of the app's building blocks (subscriptions, auth, dashboard,
// landing) in both themes at once. Fixture data only; production returns 404.
import { Layers } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { ThemeToggle } from "@/components/ThemeToggle";
import { PasswordToggle } from "@/components/auth/PasswordToggle";
import KitchenSinkFields, { StateLabel } from "@/components/dev/KitchenSinkFields";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { featureCardClass, panelClass } from "@/lib/styles";
import { cn } from "@/lib/utils";
import type { SubscriptionListItemDTO } from "@/types";

// Not a frontmatter `return new Response(...)`: typescript-eslint's no-misused-promises crashes on it.
const enabled = import.meta.env.DEV;
if (!enabled) Astro.response.status = 404;

const subscriptions: SubscriptionListItemDTO[] = [
  {
    id: "fixture-1",
    name: "Netflix",
    amount: "49.99",
    currency: "PLN",
    cycle: "monthly",
    categoryName: "Video",
    createdAt: "2026-10-01T00:00:00Z",
  },
  {
    id: "fixture-2",
    name: "Spotify Family",
    amount: "29.99",
    currency: "PLN",
    cycle: "monthly",
    categoryName: "Music",
    createdAt: "2026-10-02T00:00:00Z",
  },
  {
    id: "fixture-3",
    name: "A very long subscription name that has to wrap on a narrow screen without overflowing",
    amount: "119.00",
    currency: "EUR",
    cycle: "yearly",
    categoryName: "Productivity",
    createdAt: "2026-10-03T00:00:00Z",
  },
];

const columns = [
  { theme: "light", title: "Light" },
  { theme: "dark", title: "Dark" },
] as const;
---

{enabled && (
  <Layout title="Kitchen sink">
    <div class="grid min-h-screen w-full grid-cols-1 md:grid-cols-2">
      {columns.map(({ theme, title }) => (
        <section
          class:list={[theme === "dark" && "dark", "bg-cosmic text-foreground min-w-0 p-4 sm:p-8"]}
          aria-label={`${title} theme`}
        >
          <h1 class="text-heading mb-6 text-2xl font-bold">{title}</h1>

          <div class="flex flex-col gap-6">
            <div>
              <StateLabel>Topbar — links (hover / focus-visible by interaction)</StateLabel>
              <Topbar />
            </div>

            <div>
              <StateLabel>ThemeToggle — default (hover / focus-visible by interaction)</StateLabel>
              <ThemeToggle client:load />
            </div>

            <Card className={panelClass}>
              <StateLabel>Card — form building blocks</StateLabel>
              <h2 class="text-heading mb-6 text-2xl font-bold">Add a subscription</h2>
              <KitchenSinkFields idPrefix={theme} />
            </Card>

            <Card className={panelClass}>
              <StateLabel>Alert — success, destructive, default</StateLabel>
              <div class="flex flex-col gap-4">
                <Alert variant="success" role="status">
                  <AlertDescription>Subscription saved</AlertDescription>
                </Alert>
                <Alert variant="destructive">
                  <AlertDescription>Could not load your subscriptions. Please refresh the page.</AlertDescription>
                </Alert>
                <Alert>
                  <AlertDescription>Default alert: neutral information.</AlertDescription>
                </Alert>
              </div>
            </Card>

            <Card className={panelClass}>
              <StateLabel>List — populated</StateLabel>
              <h2 class="text-card-foreground mb-4 text-lg font-semibold">Your subscriptions</h2>
              <ul class="divide-border divide-y">
                {subscriptions.map((s) => (
                  <li class="py-3">
                    <p class="text-card-foreground font-medium break-words">{s.name}</p>
                    <p class="text-muted-foreground text-sm break-words">
                      {s.amount} {s.currency} · {s.cycle} · {s.categoryName}
                    </p>
                  </li>
                ))}
              </ul>
            </Card>

            <Card className={panelClass}>
              <StateLabel>List — empty</StateLabel>
              <h2 class="text-card-foreground mb-4 text-lg font-semibold">Your subscriptions</h2>
              <p class="text-muted-foreground text-sm">No subscriptions yet — add your first one above.</p>
            </Card>

            <Card className={cn(panelClass, "p-8")}>
              <StateLabel>Auth panel — heading, muted text, link (hover / focus-visible by interaction)</StateLabel>
              <h2 class="text-heading mb-6 text-center text-2xl font-bold">Sign in</h2>
              <p class="text-muted-foreground text-center text-sm">
                Don't have an account?{" "}
                <a
                  href="#sign-up"
                  class="text-link rounded-sm outline-none hover:underline focus-visible:ring-3 focus-visible:ring-ring/50"
                >
                  Sign up
                </a>
              </p>
            </Card>

            <Card className={panelClass}>
              <StateLabel>PasswordToggle — default (hover / focus-visible by interaction)</StateLabel>
              <div class="border-input relative h-10 rounded-lg border">
                <PasswordToggle visible={false} onToggle={() => undefined} />
              </div>
            </Card>

            <Card className={panelClass}>
              <StateLabel>Button — default, outline, size lg, disabled; link styled as a button</StateLabel>
              <div class="flex flex-wrap gap-3">
                <Button>Go to subscriptions</Button>
                <Button variant="outline">Sign out</Button>
                <Button size="lg">Sign in</Button>
                <Button variant="outline" size="lg">
                  Create account
                </Button>
                <Button disabled>Disabled</Button>
                <Button variant="outline" disabled>
                  Disabled
                </Button>
                <a href="#subscriptions" class:list={buttonVariants()}>
                  Link as button
                </a>
                <a href="#signup" class:list={buttonVariants({ variant: "outline", size: "lg" })}>
                  Outline link, lg
                </a>
              </div>
            </Card>

            <div>
              <StateLabel>Landing feature card</StateLabel>
              <Card className={featureCardClass}>
                <Layers className="text-link mb-4" aria-hidden="true" />
                <h3 class="text-card-foreground mb-2 text-lg font-semibold">Grouped by category</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  Pick a starter category or create your own, so duplicates are easier to spot.
                </p>
              </Card>
            </div>
          </div>
        </section>
      ))}
    </div>
  </Layout>
)}
