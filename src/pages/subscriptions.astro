---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import SubscriptionForm from "@/components/subscriptions/SubscriptionForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { displayableError, listCategories, listSubscriptions } from "@/lib/services/subscriptions";
import type { CategoryDTO, SubscriptionListItemDTO } from "@/types";

const saved = Astro.url.searchParams.get("saved") === "1";
// Only messages the app itself produces are shown; a crafted ?error= link gets a generic message.
const error = displayableError(Astro.url.searchParams.get("error"));

let categories: CategoryDTO[] = [];
let subscriptions: SubscriptionListItemDTO[] = [];
let loadError: string | null = null;

// A null client means Supabase is not configured: Layout shows the config banner, the page shows an empty state.
const supabase = Astro.locals.supabase;
if (supabase) {
  try {
    [categories, subscriptions] = await Promise.all([listCategories(supabase), listSubscriptions(supabase)]);
  } catch {
    loadError = "Could not load your subscriptions. Please refresh the page.";
  }
}

// Glass panel in dark (bg-card + blur), bordered white card with a shadow in light; shape and padding as before.
const sectionClass = "gap-0 rounded-2xl p-5 backdrop-blur-xl sm:p-8 dark:shadow-none";
---

<Layout title="Subscriptions">
  <div class="bg-cosmic min-h-screen w-full p-4 pb-20 sm:p-8 sm:pb-20">
    <Topbar />

    <main class="mx-auto flex w-full max-w-2xl flex-col gap-6">
      <Card className={sectionClass}>
        <h1 class="text-heading mb-6 text-2xl font-bold">Add a subscription</h1>
        {saved && (
          <Alert variant="success" role="status" className="mb-4">
            <AlertDescription>Subscription saved</AlertDescription>
          </Alert>
        )}
        <SubscriptionForm categories={categories} serverError={error} client:load />
      </Card>

      <Card className={sectionClass}>
        <h2 class="text-card-foreground mb-4 text-lg font-semibold">Your subscriptions</h2>
        {loadError ? (
          <Alert variant="destructive">
            <AlertDescription>{loadError}</AlertDescription>
          </Alert>
        ) : subscriptions.length === 0 ? (
          <p class="text-muted-foreground text-sm">No subscriptions yet — add your first one above.</p>
        ) : (
          <ul class="divide-border divide-y">
            {subscriptions.map((s) => (
              <li class="py-3">
                <p class="text-card-foreground font-medium break-words">{s.name}</p>
                <p class="text-muted-foreground text-sm break-words">
                  {s.amount} {s.currency} · {s.cycle} · {s.categoryName}
                </p>
              </li>
            ))}
          </ul>
        )}
      </Card>
    </main>
  </div>
</Layout>
