---
import { Alert, AlertDescription } from "@/components/ui/alert";

interface Props {
  /** Only the error variant exists (config warnings in Layout). */
  variant?: "error";
}

const alertVariant = { error: "destructive" } as const;
const { variant = "error" } = Astro.props;
---

<Alert variant={alertVariant[variant]} className="justify-items-center rounded-none border-x-0 border-t-0 text-center">
  <AlertDescription className="block [&_a]:font-semibold [&_a]:underline">
    <slot />
  </AlertDescription>
</Alert>
