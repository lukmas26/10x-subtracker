---
import { Layers, List, Lock } from "lucide-react";
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";

const features = [
  {
    icon: List,
    title: "All in one list",
    description: "Add each subscription with its amount, currency and billing cycle, and see them together.",
  },
  {
    icon: Layers,
    title: "Grouped by category",
    description: "Pick a starter category or create your own, so duplicates are easier to spot.",
  },
  {
    icon: Lock,
    title: "Private to you",
    description: "Your subscriptions are visible only to your account.",
  },
];
---

<div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
  <!-- Cosmic orbs and star field: dark-only, their tokens are transparent in light. -->
  <div class="bg-glow-primary blur-glow pointer-events-none absolute top-1/4 -left-24 size-87.5 rounded-full"></div>
  <div class="bg-glow-secondary blur-glow-sm pointer-events-none absolute top-2/3 -right-16 size-62.5 rounded-full"></div>
  <div class="bg-glow-tertiary blur-glow-lg pointer-events-none absolute top-0 left-1/2 size-75 -translate-x-1/2 rounded-full"></div>
  <div class="bg-starfield pointer-events-none absolute inset-0"></div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="text-heading mb-6 text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">SubTracker</h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
        See every subscription you pay for, monthly and yearly, in one list, before the next renewal slips past.
      </p>
      <!-- buttonVariants, not `Button asChild`: Astro wraps React children in <astro-slot>, which Slot cannot merge into. -->
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="/auth/signin" class={buttonVariants({ size: "lg" })}>Sign in</a>
        <a href="/auth/signup" class={buttonVariants({ variant: "outline", size: "lg" })}>Create account</a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      {features.map(({ icon: Icon, title, description }) => (
        <Card className="gap-0 p-6 backdrop-blur-xl dark:shadow-none">
          <Icon className="text-link mb-4" aria-hidden="true" />
          <h3 class="text-card-foreground mb-2 text-lg font-semibold">{title}</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">{description}</p>
        </Card>
      ))}
    </div>
  </div>
</div>
